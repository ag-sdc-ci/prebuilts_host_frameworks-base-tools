// Prebuilt shadow for frameworks/base host tools
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_prebuilt_binary {
    name: "protoc-gen-javastream",
    srcs: ["bin/protoc-gen-javastream"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "protoc-gen-cppstream",
    srcs: ["bin/protoc-gen-cppstream"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "pbkdf2gen",
    srcs: ["bin/pbkdf2gen"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

cc_prebuilt_binary {
    name: "validatekeymaps",
    srcs: ["bin/validatekeymaps"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
    shared_libs: [
        "libbinder",
        "libvintf",
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
    ],
    target: {
        host: {
            rpath: "/opt/android/system/core/lib64",
        },
    },
}

cc_prebuilt_binary {
    name: "incident-section-gen",
    srcs: ["bin/incident-section-gen"],
    check_elf_files: false,
    prefer: true,
    host_supported: true,
    device_supported: false,
}

sh_binary_host {
    name: "lockedregioncodeinjection",
    src: "bin/lockedregioncodeinjection",
}

sh_binary_host {
    name: "sdkparcelables",
    src: "bin/sdkparcelables",
}

sh_binary_host {
    name: "codegen_cli",
    src: "bin/codegen_cli",
}

sh_binary_host {
    name: "protologtool",
    src: "bin/protologtool",
}

sh_binary_host {
    name: "hoststubgen",
    src: "bin/hoststubgen",
}

java_library {
    name: "ImmutabilityAnnotation",
    srcs: ["src/android/processor/immutability/Immutable.java"],
    sdk_version: "core_current",
    host_supported: true,
}

java_plugin {
    name: "ImmutabilityAnnotationProcessor",
}

