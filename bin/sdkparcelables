#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CANDIDATES=(
    "${SCRIPT_DIR}/../lib64/sdkparcelables.jar"
    "${SCRIPT_DIR}/sdkparcelables.jar"
    "${SCRIPT_DIR}/../../../../prebuilts/host/frameworks-base-tools/lib64/sdkparcelables.jar"
    "prebuilts/host/frameworks-base-tools/lib64/sdkparcelables.jar"
    "${ANDROID_BUILD_TOP}/prebuilts/host/frameworks-base-tools/lib64/sdkparcelables.jar"
)

JAR_FILE=""
for c in "${CANDIDATES[@]}"; do
    if [ -f "$c" ]; then
        JAR_FILE="$c"
        break
    fi
done

if [ -z "$JAR_FILE" ]; then
    echo "sdkparcelables: cannot find sdkparcelables.jar" >&2
    exit 1
fi

exec java -cp "$JAR_FILE" com.android.sdkparcelables.MainKt "$@"
